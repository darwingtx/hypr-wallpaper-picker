-- Escala del monitor (extra)
--
-- Hyprland solo acepta escalas fraccionarias en pasos de 1/60, asi que
-- 1.15 se ajusta a 1.2 y 1.1 tambien a 1.0667. Usa valores "redondos".
--
-- Fichero: ~/.config/hypr/custom/general.lua
--
-- La regla global del config base (output = "") se aplica primero; esta regla
-- especifica para el monitor tiene prioridad y pisa el scale = 1.

hl.monitor({
    output = "eDP-1",
    mode = "preferred",
    position = "auto",
    scale = 1.2
})
